--  SPDX-License-Identifier: Apache-2.0
project Outline is

   --  Warnings are errors only for the checks of this repository (tests/run.sh):
   --  a newer compiler's new warning must not break the build for those who install it.
   type Strict_Kind is ("no", "yes");
   Strict : Strict_Kind := external ("OUTLINE_STRICT", "no");

   Strict_Switches := ();
   case Strict is
      when "yes" => Strict_Switches := ("-gnatwe");
      when "no"  => null;
   end case;

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("outline_main.adb");

   package Builder is
      for Executable ("outline_main.adb") use "outline";
   end Builder;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-g", "-gnatwa", "-gnatVa",
         "-gnaty3abcdefhiklM99nprStux", "-gnata") & Strict_Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--prover=cvc5,z3", "--steps=100000", "--timeout=60",
         "--checks-as-errors=on", "--report=statistics");
   end Prove;

end Outline;

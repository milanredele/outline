--  SPDX-License-Identifier: Apache-2.0
project Ada_Outline is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("ada_outline_main.adb");

   package Builder is
      for Executable ("ada_outline_main.adb") use "ada_outline";
   end Builder;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-g", "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnaty3abcdefhiklM99nprStux", "-gnata");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--prover=cvc5,z3", "--steps=100000", "--timeout=60",
         "--checks-as-errors=on", "--report=statistics");
   end Prove;

end Ada_Outline;

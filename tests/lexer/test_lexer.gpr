with "../../outline.gpr";

project Test_Lexer is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_lexer.adb");
   for Create_Missing_Dirs use "True";

   package Compiler renames Outline.Compiler;
   package Binder renames Outline.Binder;
end Test_Lexer;
